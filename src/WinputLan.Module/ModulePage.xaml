<UserControl x:Class="WinputLan.Module.ModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk">
    <!-- Design-system keys only (SwissTechKnife.Sdk theme, resolved from the host at runtime). -->
    <ScrollViewer Padding="28,8,28,28">
        <Border Style="{StaticResource Card}" Padding="24" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mouse e teclado compartilhados" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                    <Border x:Name="StatusChip" Grid.Column="1" Style="{StaticResource Chip}">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Text.Paragraph}" Margin="0,10,0,0" />
                <TextBlock x:Name="ElevationText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <StackPanel x:Name="AdminNotice" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Text.Paragraph}"
                               Text="O Winput LAN foi atualizado. Confirme a permissão de administrador mais uma vez para continuar controlando apps de administrador, como o Gerenciador de Tarefas." />
                    <Button x:Name="ConfirmAdminButton" ui:Ui.Icon="&#xE7EF;" Content="Confirmar permissão de administrador"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="ConfirmAdminButton_OnClick" />
                </StackPanel>

                <StackPanel x:Name="NetworkNotice" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Text.Paragraph}"
                               Text="O Firewall do Windows ainda não libera as conexões dos outros PCs para esta cópia do Winput LAN. Sem isso, este PC não pode ser controlado." />
                    <Button x:Name="AllowNetworkButton" ui:Ui.Icon="&#xE968;" Content="Permitir conexões de rede"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="AllowNetworkButton_OnClick" />
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,18,0,0" TextWrapping="Wrap"
                           Text="Máquinas, atalhos e preferências ficam na janela do Winput LAN, que roda em um processo próprio para que o SwissTechKnife nunca atrase o controle remoto. Os avisos do Windows (UAC) só aparecem quando você clica em uma opção que precisa de administrador." />
                <Button x:Name="OpenButton" Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE8A7;"
                        Content="Abrir Winput LAN" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OpenButton_OnClick" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

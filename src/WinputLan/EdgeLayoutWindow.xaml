<Window x:Class="WinputLan.EdgeLayoutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WinputLan.Controls" Title="Conexão pelas extremidades" Width="860" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><Image Source="/WinputLan;component/assets/brand/icon-normalized.png" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="Conexão pelas extremidades" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <Button Grid.Column="1" Style="{StaticResource CloseChromeButton}" Click="Close_Click" AutomationProperties.Name="Fechar janela"><controls:Icon Data="{StaticResource Icon.X}" Width="16" Height="16" StrokeThickness="1.5"/></Button>
  </Grid>
  <StackPanel Grid.Row="1" Margin="24,18,24,20">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Arraste para organizar. As máquinas sempre grudam e se alinham." Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="14" Height="14" CornerRadius="3" Background="#2B4252" VerticalAlignment="Center"/><TextBlock x:Name="LocalLegendText" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/><TextBlock Text="este computador" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
     <Border Width="14" Height="14" CornerRadius="3" Background="#3A3960" Margin="20,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="RemoteLegendText" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border Background="{StaticResource RailBrush}" Margin="0,14,0,0" Height="380" ClipToBounds="True"><Canvas x:Name="Stage" Background="Transparent" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseLeftButtonUp" LostMouseCapture="Stage_LostMouseCapture"/></Border>
   <Border Background="{StaticResource SurfaceBrush}" Padding="16,12" Margin="0,10,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <controls:Icon Data="{StaticResource Icon.MousePointer}" Width="18" Height="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="SummaryDetail" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"/></StackPanel>
     <Border Grid.Column="2" Background="#234B31" CornerRadius="11" Padding="9,3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="SummaryBadgeText" Foreground="{StaticResource AccentStrongBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
    </Grid>
   </Border>
   <Grid Margin="0,16,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <CheckBox x:Name="ConnectCheckBox" Content="Conectar pela extremidade quando desconectado" VerticalAlignment="Center" ToolTip="Ao tocar a extremidade deste PC, conecta à máquina reconhecida como o atalho faria e passa o controle para ela. Depois de desconectar pelo botão, só volta a valer quando você reconectar."/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource QuietButton}" Content="Cancelar" Click="Close_Click"/><Button Style="{StaticResource PrimaryWideButton}" Margin="10,0,0,0" Click="Save_Click" AutomationProperties.Name="Salvar"><TextBlock Text="Salvar" FontSize="14" FontWeight="SemiBold"/></Button></StackPanel>
   </Grid>
  </StackPanel>
 </Grid>
</Window>

ht="42" Fill="#536062"/><StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="30,0,0,0"><TextBlock x:Name="TargetStateText" Text="Aguardando atalho" FontSize="17"/><TextBlock x:Name="LatencyText" Text="Ainda não conectado" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="5" Text="›" FontSize="44" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>

    <Grid Grid.Row="0" Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Máquinas" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Compartilhe mouse e teclado entre PCs Windows na sua rede local." FontSize="17" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel><Button Grid.Column="1" x:Name="PairNowButton" Style="{StaticResource PrimaryWideButton}" Width="230" HorizontalAlignment="Right" VerticalAlignment="Center" Click="PairNowButton_Click" AutomationProperties.Name="Controlar outra máquina"><Grid HorizontalAlignment="Center" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Grid.Column="0" Width="24" Height="24"><Path Data="M12,3 L12,21 M3,12 L21,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Grid.Column="2" Text="Controlar outra máquina" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Button></Grid>

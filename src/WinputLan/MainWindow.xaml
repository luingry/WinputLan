<Window x:Class="WinputLan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winput LAN"
        Width="1120" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Grid Margin="26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
                <Image Source="/WinputLan;component/assets/brand/icon-normalized.png" Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="WINPUT" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="LAN" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="OPERATING SPACE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
            <Button x:Name="MachinesButton" Content="Machines" HorizontalContentAlignment="Left" Click="MachinesButton_Click" Background="{StaticResource RaisedBrush}" />
            <Button x:Name="PairingButton" Content="Pairing" HorizontalContentAlignment="Left" Click="PairingButton_Click" />
            <Button x:Name="ShortcutsButton" Content="Shortcuts" HorizontalContentAlignment="Left" Click="ShortcutsButton_Click" />
            <Button x:Name="UpdatesButton" Content="Updates" HorizontalContentAlignment="Left" Click="UpdatesButton_Click" />
            <Border Height="1" Background="#3A4142" Margin="0,30,8,20" />
            <TextBlock Text="THIS SESSION" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="2,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Local input" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <TextBlock Text="Ctrl + Shift + Alt + 1" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="18,0,0,16" />
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="RemoteDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="2,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Remote input" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <TextBlock Text="Ctrl + Shift + Alt + 2" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="18,0,0,0" />
            <TextBlock x:Name="VersionText" Text="version" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,40,0,0" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="Machines" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="One active target. Inputs stay on your LAN." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStateText" Text="LOCAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentStrongBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="PairNowButton" Content="Pair a machine" Style="{StaticResource PrimaryButton}" Click="PairNowButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><TextBlock Text="THIS PC" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="LocalNameText" Text="Local machine" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Grid.Row="1" x:Name="LocalIdText" Text="device id" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,17" />
                        <Grid Grid.Row="2" Margin="0,0,0,18"><TextBlock Text="LISTENING" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ListenText" Text="TCP 45900 · Private" FontSize="13" HorizontalAlignment="Right" /></Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Ready for a paired peer" Foreground="{StaticResource AccentStrongBrush}" FontSize="12" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><TextBlock Text="ACTIVE TARGET" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="RemoteNameText" Text="No target" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Grid.Row="1" x:Name="RemoteAddressText" Text="Pair a machine to begin" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,17" />
                        <Grid Grid.Row="2" Margin="0,0,0,18"><TextBlock Text="LATENCY" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="LatencyText" Text="—" FontSize="13" HorizontalAlignment="Right" /></Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal"><Ellipse x:Name="TargetStateDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock x:Name="TargetStateText" Text="Offline · local input active" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><TextBlock Text="TRANSACTION LOG" FontSize="10" Foreground="{StaticResource MutedBrush}" /><Button Content="Clear" HorizontalAlignment="Right" Padding="10,4" Margin="0" Click="ClearLogButton_Click" /></Grid>
                        <TextBlock Grid.Row="1" Text="No typed content is recorded." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" />
                        <ListView Grid.Row="2" x:Name="LogList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,3" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="3" x:Name="LogStatusText" Text="0 events this session" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PAIRING" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Confirm the same code on both PCs." FontSize="18" FontWeight="SemiBold" Margin="0,9,0,5" />
                        <TextBlock Text="TLS is used for the connection. After confirmation, the peer certificate is pinned and protected with Windows DPAPI." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18" />
                        <TextBlock Text="PEER ADDRESS" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,17,0,0" />
                        <TextBox x:Name="RemoteAddressBox" Text="127.0.0.1" AutomationProperties.Name="Peer address" />
                        <Button x:Name="ConnectPairButton" Content="Connect &amp; pair" Style="{StaticResource PrimaryButton}" Click="ConnectPairButton_Click" />
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="15" Margin="0,22,0,17">
                            <StackPanel HorizontalAlignment="Center"><TextBlock Text="SHARED CODE" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" /><TextBlock x:Name="PairCodeText" Text="—— ——" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource AccentStrongBrush}" HorizontalAlignment="Center" Margin="0,8,0,3" /><TextBlock x:Name="PairCodeStateText" Text="Not available until a peer offers" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" /></StackPanel>
                        </Border>
                        <Button x:Name="ConfirmPairButton" Content="Confirm code" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ConfirmPairButton_Click" />
                        <Button Content="How pairing works" Click="HowPairingButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

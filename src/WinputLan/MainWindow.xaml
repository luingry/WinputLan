    <StackPanel Margin="18,25,18,0">
     <Button x:Name="UpdatesButton" Style="{StaticResource RailButtonActive}" Click="UpdatesButton_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="29" Height="29"><Canvas Width="30" Height="30"><Path Data="M5,14 A10,10 0 0 1 22,8" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M22,8 L18,4 M22,8 L26,4" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M25,16 A10,10 0 0 1 8,22" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M8,22 L12,26 M8,22 L4,26" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock x:Name="UpdatesButtonText" Text="Atualizações" FontSize="19" FontWeight="SemiBold" Margin="26,0,0,0"/></StackPanel></Button>

<Window x:Class="WinputLan.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WinputLan.Controls" Title="Winput LAN" Width="1564" Height="1006" MinWidth="1060" MinHeight="680" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" SnapsToDevicePixels="True" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid>

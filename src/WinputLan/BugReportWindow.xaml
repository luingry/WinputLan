<Window x:Class="WinputLan.BugReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reportar problema — Winput LAN" Width="680" Height="790" MinWidth="540" MinHeight="580" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Reportar problema" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Conte o que aconteceu para ajudar a corrigir o Winput LAN." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,5,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
   <Label Target="{Binding ElementName=TitleBox}" Foreground="{StaticResource TextBrush}" Padding="0" Content="_Título"/><TextBox x:Name="TitleBox" MaxLength="160" AutomationProperties.Name="Título do problema" TextChanged="Fields_Changed"/>
   <Label Target="{Binding ElementName=DescriptionBox}" Foreground="{StaticResource TextBrush}" Padding="0" Content="_O que aconteceu?"/><TextBox x:Name="DescriptionBox" MaxLength="6000" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="O que aconteceu" TextChanged="Fields_Changed"/>
   <Label Target="{Binding ElementName=StepsBox}" Foreground="{StaticResource TextBrush}" Padding="0" Content="_Como reproduzir? (opcional)"/><TextBox x:Name="StepsBox" MaxLength="4000" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Como reproduzir" TextChanged="Fields_Changed"/>
   <Border Background="{StaticResource SurfaceBrush}" Padding="14" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="Diagnóstico técnico incluído automaticamente" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
    <TextBlock Text="Versões, monitores, estado da conexão e eventos recentes. Sem conteúdo digitado ou códigos de acesso." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,5,0,6"/>
    <Expander x:Name="DiagnosticExpander" Header="Ver detalhes" Foreground="{StaticResource TextBrush}"><TextBox x:Name="DiagnosticPreview" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Diagnóstico técnico"/></Expander>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <!-- A HWND-backed WebView must stay outside the scrolling viewport to avoid covering native status/actions. -->
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <Grid x:Name="ChallengeHost" Height="112" Background="{StaticResource ChromeBrush}"/>
   <Button x:Name="VerifyButton" Content="Refazer verificação" Style="{StaticResource TextActionButton}" HorizontalAlignment="Left" Margin="0,6,0,8" Click="Verify_Click"/>
   <TextBlock x:Name="StatusText" Text="Preparando diagnóstico…" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="NewButton" Content="Novo relato" Style="{StaticResource TextActionButton}" HorizontalAlignment="Left" Click="New_Click"/>
   <Button Grid.Column="1" Content="Fechar" Style="{StaticResource TextActionButton}" Margin="0,0,12,0" Click="Close_Click"/>
   <Button x:Name="SendButton" Grid.Column="2" Content="Enviar relato" Style="{StaticResource PrimaryWideButton}" IsEnabled="False" Click="Send_Click" AutomationProperties.Name="Enviar relato"/>
  </Grid></StackPanel>
 </Grid>
</Window>

<Window x:Class="WinputLan.BugReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WinputLan.Controls" Title="Reportar problema" Width="680" Height="650" MinWidth="540" MinHeight="580" WindowStyle="None" ResizeMode="CanResize" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="ReportScrollThumb" TargetType="Thumb">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#5B686B" CornerRadius="3" Margin="2,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource MutedBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ReportScrollPage" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Scoped to this dialog, including the multiline TextBox scroll viewers. -->
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ReportScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ReportScrollThumb}" MinHeight="28"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ReportScrollPage}"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><Image Source="/WinputLan;component/assets/brand/icon-normalized.png" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="Reportar problema" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" AutomationProperties.Name="Minimizar"><controls:Icon Data="{StaticResource Icon.Minus}" Width="16" Height="16" StrokeThickness="1.5"/></Button><Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" AutomationProperties.Name="Maximizar"><controls:Icon Data="{StaticResource Icon.Square}" Width="14" Height="14" StrokeThickness="1.75"/></Button><Button Style="{StaticResource CloseChromeButton}" Click="Close_Click" AutomationProperties.Name="Fechar janela"><controls:Icon Data="{StaticResource Icon.X}" Width="16" Height="16" StrokeThickness="1.5"/></Button></StackPanel>
  </Grid>
 <Grid x:Name="ReportForm" Grid.Row="1" Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Conte o que aconteceu para ajudar a corrigir o Winput LAN." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
  <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
   <Label Target="{Binding ElementName=TitleBox}" Foreground="{StaticResource TextBrush}" Padding="0" Content="_Título"/><TextBox x:Name="TitleBox" MaxLength="160" Margin="0,6,0,4" AutomationProperties.Name="Título do problema" TextChanged="Fields_Changed"/>
   <TextBlock DataContext="{Binding ElementName=TitleBox}" Style="{StaticResource Text.Secondary}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,12"><TextBlock.Text><MultiBinding StringFormat="{}{0} / {1} caracteres"><Binding Path="Text.Length"/><Binding Path="MaxLength"/></MultiBinding></TextBlock.Text></TextBlock>
   <Label Target="{Binding ElementName=DescriptionBox}" Foreground="{StaticResource TextBrush}" Padding="0" Content="_O que aconteceu?"/><TextBox x:Name="DescriptionBox" MaxLength="1000" Height="130" Margin="0,6,0,4" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="O que aconteceu" TextChanged="Fields_Changed"/>
   <TextBlock DataContext="{Binding ElementName=DescriptionBox}" Style="{StaticResource Text.Secondary}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,12"><TextBlock.Text><MultiBinding StringFormat="{}{0} / {1} caracteres"><Binding Path="Text.Length"/><Binding Path="MaxLength"/></MultiBinding></TextBlock.Text></TextBlock>
   <Label Target="{Binding ElementName=StepsBox}" Foreground="{StaticResource TextBrush}" Padding="0" Content="_Como reproduzir? (opcional)"/><TextBox x:Name="StepsBox" MaxLength="1000" Height="92" Margin="0,6,0,4" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Como reproduzir" TextChanged="Fields_Changed"/>
   <TextBlock DataContext="{Binding ElementName=StepsBox}" Style="{StaticResource Text.Secondary}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,12"><TextBlock.Text><MultiBinding StringFormat="{}{0} / {1} caracteres"><Binding Path="Text.Length"/><Binding Path="MaxLength"/></MultiBinding></TextBlock.Text></TextBlock>
  </StackPanel></ScrollViewer>
  <!-- A HWND-backed WebView must stay outside the scrolling viewport to avoid covering native status/actions. -->
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <Grid x:Name="ChallengeHost" Height="84" Background="{StaticResource ChromeBrush}" Visibility="Collapsed" Margin="0,0,0,12"/>
   <TextBlock x:Name="StatusText" Visibility="Collapsed" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Grid.Column="1" Content="Fechar" Style="{StaticResource TextActionButton}" Margin="0,0,12,0" Click="Close_Click"/>
   <Button x:Name="SendButton" Grid.Column="2" Content="Enviar relato" Style="{StaticResource PrimaryWideButton}" IsEnabled="False" Click="Send_Click" AutomationProperties.Name="Enviar relato"/>
  </Grid></StackPanel>
 </Grid>
 <Grid x:Name="SuccessOverlay" Grid.RowSpan="2" Panel.ZIndex="10" Background="{StaticResource WindowBrush}" Visibility="Collapsed" Focusable="True" AutomationProperties.Name="Enviado com sucesso">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
   <Border Width="72" Height="72" CornerRadius="36" Background="#1C2A22" HorizontalAlignment="Center" Margin="0,0,0,18">
    <controls:Icon Data="{StaticResource Icon.Check}" Width="36" Height="36" StrokeThickness="2" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <TextBlock Text="Enviado com sucesso" Style="{StaticResource Text.DialogTitle}" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
 </Grid>
</Window>
